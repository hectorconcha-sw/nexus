{
  "title": "Nexus Overview",
  "uid": "nexus-overview",
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP Server Duration (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_duration_milliseconds_bucket[5m])) by (le, http_route))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Logs from Auth Service",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service_name=\"nexus-auth\"}"
        }
      ]
    },
    {
      "type": "traces",
      "title": "Traces from Auth Service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "query": "{ resource.service.name = \"nexus-auth\" }",
          "refId": "A"
        }
      ]
    }
  ]
}
