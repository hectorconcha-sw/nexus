# ─────────────────────────────────────────────────────────────
# Nexus — local development environment
# Copy this file to `.env` and adjust as needed.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Postgres (bootstrap instance)
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev_password
POSTGRES_DB=nexus
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=nexus_dev_password
REDIS_PORT=6379

# Web UIs
ADMINER_PORT=8080
REDISINSIGHT_PORT=8001

# ─────────────────────────────────────────────────────────────
# Per-service database URLs
# Each service owns its own database on the shared Postgres instance.
# In production these point at separate RDS instances.
# ─────────────────────────────────────────────────────────────
AUTH_DATABASE_URL=postgres://auth_service:auth_dev_password@postgres:5432/nexus_auth
CATALOG_DATABASE_URL=postgres://catalog_service:catalog_dev_password@postgres:5432/nexus_catalog
CART_DATABASE_URL=postgres://cart_service:cart_dev_password@postgres:5432/nexus_cart
ORDERS_DATABASE_URL=postgres://orders_service:orders_dev_password@postgres:5432/nexus_orders
PAYMENTS_DATABASE_URL=postgres://payments_service:payments_dev_password@postgres:5432/nexus_payments
INVENTORY_DATABASE_URL=postgres://inventory_service:inventory_dev_password@postgres:5432/nexus_inventory
NOTIFICATIONS_DATABASE_URL=postgres://notifications_service:notifications_dev_password@postgres:5432/nexus_notifications
ANALYTICS_DATABASE_URL=postgres://analytics_service:analytics_dev_password@postgres:5432/nexus_analytics